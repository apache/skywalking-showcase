comma := ,

.EXPORT_ALL_VARIABLES:
DEBUG ?= false

DOCKER_BUILDKIT ?= 1
HUB ?= ghcr.io/apache/skywalking-showcase
TAG ?= $(shell git rev-parse --short HEAD)

BANYANDB_IMAGE ?= ghcr.io/apache/skywalking-banyandb
# banyandb-tail-sampling resolves the "-plugins" / "-plugins-carrier" variants of this tag. Both
# must exist AND the carrier must ship the first-party samplers (sw-trace-sampler.so,
# zipkin-trace-sampler.so), which land in d552528a — an earlier tag carries only the reference
# latencystatussampler.so, and the sampler then fails to load with "realpath failed".
BANYANDB_IMAGE_TAG ?= a4ec2d7e986d76bd99b284e18f820e083327755f
STORAGE_CLASS ?= ""

ES_IMAGE ?= docker.elastic.co/elasticsearch/elasticsearch-oss
ES_IMAGE_TAG ?= 7.10.2

SW_OAP_IMAGE ?= ghcr.io/apache/skywalking/oap
# banyandb-tail-sampling needs the bydb.yml `pipeline` block, which lands in c66a476a (#13965).
SW_OAP_IMAGE_TAG ?= 289b4b3bd2e271ef6b617cfb3f64987fe29a8265

SW_UI_IMAGE ?= ghcr.io/apache/skywalking-horizon-ui
SW_UI_IMAGE_TAG ?= 53c1f63b635bc8efbaec0e4bc28ec9539e526328

# The AI Sessionizer. No real Claude Code runs in the showcase, so its scenario feed is the
# only traffic of the AI_AGENT layer.
SW_ASZ_IMAGE ?= ghcr.io/apache/skywalking-ai-sessionizer
SW_ASZ_IMAGE_TAG ?= 0f9612b060390f36e43c753bfeb087cc0500efb5
# The scenarios its feed picks from, as an image built from services/asz-scenarios. They are too large to
# ride in the Helm release, which Helm keeps in one Secret of at most 1 MiB. The tag is one publish-images
# pushed after a merge.
SW_ASZ_SCENARIOS_IMAGE ?= ghcr.io/apache/skywalking-showcase/asz-scenarios
SW_ASZ_SCENARIOS_IMAGE_TAG ?= 6477d6b

SW_CLI_IMAGE ?= ghcr.io/apache/skywalking-cli/skywalking-cli:bce7faaabbd57ed1f40156af8a8eb6c3eccea4ae
SW_EVENT_EXPORTER_IMAGE ?= ghcr.io/apache/skywalking-kubernetes-event-exporter/skywalking-kubernetes-event-exporter:8a012a3f968cb139f817189afb9b3748841bba22
SW_AGENT_JAVA_IMAGE ?= ghcr.io/apache/skywalking-java/skywalking-java:a9b0cf4ca1a424dcd8b1cdad7beb6289465ea363-java8
SW_AGENT_GO_IMAGE ?= ghcr.io/apache/skywalking-go/skywalking-go:924fc3238ad2c920fd7186bb941ec1d5d5b41b43-go1.19

SW_AGENT_NODEJS_BACKEND_VERSION ?= 36df516f737bfc665dab7312703d826f9dcf527e
SW_AGENT_NODEJS_FRONTEND_VERSION ?= dce0d5b39ab95b8062031bc74e6f7a191f08e186

SW_SATELLITE_IMAGE ?= ghcr.io/apache/skywalking-satellite/skywalking-satellite
SW_SATELLITE_IMAGE_TAG ?= v3cfaf59a755e7ffcd900d6695a8bc4174397cace

SW_ROVER_IMAGE ?= ghcr.io/apache/skywalking-rover/skywalking-rover:b77436d99566aae0f766358d359145c77073ef11

SWCK_OPERATOR_IMAGE ?= ghcr.io/apache/skywalking-swck/operator
SWCK_OPERATOR_IMAGE_TAG ?= 7ce378f6c01a62fd42ff47f4c98e1e95b54a40ca

SW_GRAFANA_PLUGIN_VERSION ?= 0.1.0
GRAFANA_IMAGE ?= grafana/grafana:12.4.2

OTEL_COLLECTOR_IMAGE ?= otel/opentelemetry-collector
OTEL_COLLECTOR_IMAGE_TAG ?= 0.102.1

SW_R3_IMAGE ?= ghcr.io/skyapm/r3
SW_R3_IMAGE_TAG ?= 0.1.0

CILIUM_VERSION ?= 1.13.4
CILIUM_CLI_VERSION ?= v0.15.0

# cert-manager is installed as a release of its own -- see the `cert-manager` target in
# deploy/platform/kubernetes/Makefile for why it is not a chart dependency. Where the
# target cluster already runs cert-manager, keep this pin in step with it so the install
# is a no-op rather than a version flap.
CERT_MANAGER_VERSION ?= v1.16.0

SW_PREDICTOR_IMAGE ?= ghcr.io/skyapm/skypredictor:66cd881d8316e7bd958a2172a99d2fc33f707150

# ALL variables should be listed above ^^
EXPORTED_VARS := $(filter-out <%,$(.VARIABLES))
