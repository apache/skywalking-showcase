{{/*
Slack message of the Alertmanager, shared by Kubernetes and Docker Compose. The platform's own template file defines
slack.channel, slack.prometheus_url (the Prometheus address the links point to, no trailing slash) and slack.footer.
The graph window is one hour ending 30m (1800000000000 ns) after the start of the firing alert, or after the end of the
resolved one. The link line is left out when there is neither a graph annotation nor a GeneratorURL.
*/}}
{{ define "slack.title" -}}
{{ if eq .Status "firing" }}{{ if eq .CommonLabels.severity "critical" }}:rotating_light: [CRITICAL]{{ else }}:warning: [WARNING]{{ end }}{{ else }}:white_check_mark: [RESOLVED]{{ end }} {{ .CommonLabels.alertname }}
{{- end }}

{{ define "slack.fallback" -}}
{{ if eq .Status "firing" }}[FIRING]{{ else }}[RESOLVED]{{ end }} {{ .CommonLabels.alertname }}
{{- end }}

{{ define "slack.text" -}}
{{ range .Alerts.Firing -}}
{{ $end := (.StartsAt.Add 1800000000000).UTC.Format "2006-01-02T15:04:05" -}}
{{ $path := "" -}}
{{ if .GeneratorURL }}{{ $path = printf "%s&g0.range_input=1h&g0.end_input=%s" (reReplaceAll "g0\\.tab=1" "g0.tab=0" (reReplaceAll "^https?://[^/]+" "" .GeneratorURL)) $end }}{{ end -}}
{{ with .Annotations.graph }}{{ $path = printf "/graph?g0.expr=%s&g0.tab=0&g0.range_input=1h&g0.end_input=%s" (urlquery .) $end }}{{ end -}}
*{{ .Labels.alertname }}* (severity: {{ .Labels.severity }}, status: firing)
{{ with .Labels.pod_name }}pod: {{ . }}
{{ end }}{{ with .Labels.container_name }}container: {{ . }}
{{ end }}{{ .Annotations.summary }}
{{ .Annotations.description }}
{{ with $path }}<{{ template "slack.prometheus_url" }}{{ reReplaceAll "&" "&amp;" . }}|Open in Prometheus>
{{ end }}
{{ end }}{{ range .Alerts.Resolved -}}
{{ $end := (.EndsAt.Add 1800000000000).UTC.Format "2006-01-02T15:04:05" -}}
{{ $path := "" -}}
{{ if .GeneratorURL }}{{ $path = printf "%s&g0.range_input=1h&g0.end_input=%s" (reReplaceAll "g0\\.tab=1" "g0.tab=0" (reReplaceAll "^https?://[^/]+" "" .GeneratorURL)) $end }}{{ end -}}
{{ with .Annotations.graph }}{{ $path = printf "/graph?g0.expr=%s&g0.tab=0&g0.range_input=1h&g0.end_input=%s" (urlquery .) $end }}{{ end -}}
*{{ .Labels.alertname }}* (severity: {{ .Labels.severity }}, status: resolved)
{{ with .Labels.pod_name }}pod: {{ . }}
{{ end }}{{ with .Labels.container_name }}container: {{ . }}
{{ end }}{{ .Annotations.summary }}
{{ with $path }}<{{ template "slack.prometheus_url" }}{{ reReplaceAll "&" "&amp;" . }}|Open in Prometheus>
{{ end }}
{{ end }}{{ template "slack.footer" }}
{{- end }}
